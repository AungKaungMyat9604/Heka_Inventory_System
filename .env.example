# Log level: DEBUG | INFO | WARN | ERROR | FATAL | SILENT (default: DEBUG in dev, INFO in prod)
LOG_LEVEL=

# Optional: browser-visible app name (see src/lib/config/app.config.ts)
PUBLIC_APP_NAME=

# Replace with your DB credentials!
DATABASE_URL=
# Neon / Fly: use a direct (non-pooled) connection for drizzle-kit push in CI/release.
# If unset, drizzle-kit falls back to DATABASE_URL. App runtime can still use a pooled URL.
DATABASE_URL_MIGRATE=

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_BASE_URL=http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5678

# Argon2 password hashing (optional overrides)
ARGON2_MEMORY_COST=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=
ARGON2_HASH_LENGTH=

# Mailing Information
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Optional: receive new IT support ticket notifications (see support-ticket.remote)
SUPPORT_IT_EMAIL=

# TinyMCE Cloud (client; optional — see src/lib/component/own/tinymce/TinyMceEditor.svelte)
PUBLIC_TINYMCE_API_KEY=

# Bucket (Tigris)
TIGRIS_STORAGE_ACCESS_KEY_ID=
TIGRIS_STORAGE_SECRET_ACCESS_KEY=
TIGRIS_STORAGE_BUCKET=
TIGRIS_STORAGE_ENDPOINT=
TIGRIS_STORAGE_IAM_ENDPOINT=

# Playwright E2E (optional — signed-in tests skip if unset)
E2E_LOGIN_EMAIL=
E2E_LOGIN_PASSWORD=
# Optional override when not using default preview URL from playwright.config
E2E_BASE_URL=